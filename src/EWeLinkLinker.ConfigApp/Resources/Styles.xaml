<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         全应用唯一的取值表（Windows 11 浅色 Fluent 基准）。
         以前这里有一份、MainWindow.xaml 里又有一份同名 key（Divider 一份 #E0E0E0 一份 #EEEEEE），
         本地那份把这份遮住了，改主题只会改到一半。现在只允许这一份。
         字号只有四档：Caption 12 / Body 13 / Title 15 / PageTitle 18。10px 中文在 100% 缩放下是糊的。
         ============================================================ -->

    <!-- 颜色 -->
    <Color x:Key="PageColor">#F3F3F3</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="SubtleColor">#FAFAFA</Color>
    <Color x:Key="SubtleHoverColor">#F0F0F0</Color>
    <Color x:Key="DividerColor">#E5E5E5</Color>
    <!-- 天蓝。大面积填充（主按钮底）用 #38BDF8，字必须换成深天蓝墨 #0B3B52：白字在浅天蓝上只有 2.77，读不清。
         小面积强调（焦点描边、勾选边框、logo 块、图标）用深一档的 #0A74AD，白字 5.10 达标。逐对实测见 %TEMP%\ewl_hold\contrast_final.txt -->
    <Color x:Key="AccentColor">#0A74AD</Color>
    <Color x:Key="AccentFillColor">#38BDF8</Color>
    <Color x:Key="AccentFillHoverColor">#5CC6FA</Color>
    <Color x:Key="AccentFillPressedColor">#2AB4EE</Color>
    <Color x:Key="AccentInkColor">#0B3B52</Color>
    <Color x:Key="AccentSoftColor">#EAF6FD</Color>
    <Color x:Key="TextColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#5D5D5D</Color>
    <Color x:Key="TextTertiaryColor">#8A8A8A</Color>
    <Color x:Key="OnlineColor">#0F7B0F</Color>
    <Color x:Key="OfflineColor">#9A9A9A</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>
    <Color x:Key="DangerSoftColor">#FDEBE9</Color>

    <!-- 画刷 -->
    <SolidColorBrush x:Key="BgPageBrush" Color="{StaticResource PageColor}"/>
    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="{StaticResource SubtleHoverColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentFillColor}"/>
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="{StaticResource AccentFillHoverColor}"/>
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="{StaticResource AccentFillPressedColor}"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource OnlineColor}"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource OfflineColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerSoftColor}"/>

    <!-- 圆角 / 字号 / 间距 -->
    <CornerRadius x:Key="CardCorner">8</CornerRadius>
    <CornerRadius x:Key="ControlCorner">4</CornerRadius>
    <system:Double x:Key="FontSizeCaption">12</system:Double>
    <system:Double x:Key="FontSizeBody">13</system:Double>
    <system:Double x:Key="FontSizeTitle">15</system:Double>
    <Thickness x:Key="GapS">4,4,4,4</Thickness>
    <Thickness x:Key="GapM">8,8,8,8</Thickness>
    <Thickness x:Key="GapL">12,12,12,12</Thickness>

    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- 键盘焦点环：按钮换了自定义模板后没有焦点外观，下拉框用的是系统那圈虚线，
         两种风格混在一起；只用键盘走 Tab 时统一成同一圈强调色。放在最前面：StaticResource 不能前向引用。 -->
    <Style x:Key="AccentFocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                            CornerRadius="6" Margin="-2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 隐式默认值（不写 x:Key，全局生效） ===================== -->
    <!-- 隐式 TextBlock 这里不能设 Foreground：样式 setter 的优先级高于"从按钮继承下来的前景"，
         一设就把 PrimaryButton 自己的墨色盖掉（实测按钮字变成 #1A1A1A 而不是 #0B3B52）。
         默认字色改由 MainWindow 根元素上的 TextElement.Foreground 继承提供。 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 输入框：浅色底 + 1px 描边，焦点时底边换强调色（Fluent 的下划线式强调） -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 下拉框：同样式，但 ComboBox 的默认模板没有可命名的描边 Border，
         所以这里只统一字号/高度/底色，外观靠 BorderBrush 走系统模板 -->
    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Background" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===================== 具名样式 ===================== -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 卡片：阴影只在悬停时给。原来每张卡常驻一个 DropShadowEffect，
         WPF 里 Effect 会强制离屏位图，肉眼几乎看不出来（Opacity 0.08）但开销照付。 -->
    <Style x:Key="DeviceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCorner}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.12" Color="#000000"/>
                    </Setter.Value>
                </Setter>
                <!-- 悬停描边不能用浅天蓝：#BFE4F8 对白卡只有 1.34，等于没有 -->
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 设备卡给死宽度（规则卡共用上面那条，不能写死）。定宽之后 WrapPanel 才能一行排两张；
         不定宽时每张随通道数变宽窄，宽的插排会把窄的挤成一行一张，左栏右边就空出一大块。 -->
    <Style x:Key="DeviceCardTileStyle" TargetType="Border" BasedOn="{StaticResource DeviceCardStyle}">
        <Setter Property="Width" Value="210"/>
    </Style>

    <!-- 主按钮：强调色底、4px 圆角、悬停/按下有反馈 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlCorner}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentFillPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次按钮：白底描边 -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCorner}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮：内容是一条 Path（不靠 emoji、不靠图标字体的字形码） -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlCorner}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- 老界面里裸写的 #F8F9FB / Gray 输入框走这个 -->
    <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
    <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>

    <!-- 通道开关：原来全是灰底描边，看不出能点、也看不出开没开 -->
    <Style x:Key="ChannelButton" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{StaticResource SubtleBrush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource ControlCorner}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="led" Width="7" Height="7" Margin="0,0,6,0"
                                     Fill="{StaticResource StatusOfflineBrush}" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="led" Property="Fill" Value="{StaticResource StatusOnlineBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
