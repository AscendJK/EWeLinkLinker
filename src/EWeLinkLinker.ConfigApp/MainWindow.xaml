<Window x:Class="EWeLinkLinker.ConfigApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EWeLinkLinker.ConfigApp"
        xmlns:core="clr-namespace:EWeLinkLinker.Core.Models;assembly=EWeLinkLinker.Core"
        mc:Ignorable="d"
        x:Name="MainWindowRoot"
        Title="EWeLink Linker" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:BoolToStringConverter x:Key="BoolToText" TrueValue="是" FalseValue="否"/>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>
        <local:ComparisonToDisplayConverter x:Key="ComparisonToDisplayConverter"/>

        <!-- (模板选择器已移除，改用 Visibility 绑定) -->

        <!-- Colors -->
        <Color x:Key="BgPage">#F5F6FA</Color>
        <Color x:Key="BgCard">#FFFFFFFF</Color>
        <Color x:Key="Accent">#2196F3</Color>
        <Color x:Key="AccentDark">#1976D2</Color>
        <Color x:Key="AccentLight">#E3F2FD</Color>
        <Color x:Key="StatusOnline">#4CAF50</Color>
        <Color x:Key="StatusOffline">#9E9E9E</Color>
        <Color x:Key="TextPrimary">#212121</Color>
        <Color x:Key="TextSecondary">#757575</Color>
        <Color x:Key="Divider">#EEEEEE</Color>
        <Color x:Key="Danger">#F44336</Color>
        <Color x:Key="DangerLight">#FFEBEE</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BgPageBrush" Color="{StaticResource BgPage}"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDark}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}"/>
        <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource StatusOnline}"/>
        <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource StatusOffline}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
        <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLight}"/>

        <!-- Corner Radii -->
        <CornerRadius x:Key="CardCorner">12</CornerRadius>
        <CornerRadius x:Key="ControlCorner">8</CornerRadius>

        <!-- Device Card Style -->
        <Style x:Key="DeviceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardCorner}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Modern ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Icon Button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Danger Icon Button (红色删除按钮) -->
        <Style x:Key="DangerIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Channel Toggle Button -->
        <Style x:Key="ChannelButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

    </Window.Resources>

    <!-- ==================== Main Layout ==================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ===== ROW 0: Top Status Bar ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="6"
                            Width="28" Height="28" Margin="0,0,10,0">
                        <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="EWeLink Linker" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Service Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse x:Name="ServiceStatusDot" Width="9" Height="9"
                             Fill="{StaticResource StatusOfflineBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ServiceStatusText" Text="服务: 检测中..."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Service Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallServiceBtn" Content="安装" Style="{StaticResource GhostButton}"
                            Click="InstallService_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ToggleServiceBtn" Content="启动" Style="{StaticResource GhostButton}"
                            Click="ToggleService_Click" Margin="0,0,6,0"/>
                    <Button x:Name="RemoveServiceBtn" Content="卸载" Style="{StaticResource GhostButton}"
                            Click="RemoveService_Click" Margin="0,0,16,0"/>
                    <CheckBox x:Name="LoggingCheckBox" Content="日志" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,6,0"
                              Checked="LoggingCheckBox_Checked" Unchecked="LoggingCheckBox_Unchecked"/>
                    <TextBlock Text="轮询:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <ComboBox x:Name="PollingIntervalCombo" Width="60" VerticalAlignment="Center"
                              SelectedIndex="3" Margin="0,0,6,0" SelectionChanged="PollingIntervalCombo_SelectionChanged">
                        <ComboBoxItem Content="1s"/>
                        <ComboBoxItem Content="2s"/>
                        <ComboBoxItem Content="3s"/>
                        <ComboBoxItem Content="5s"/>
                        <ComboBoxItem Content="10s"/>
                        <ComboBoxItem Content="15s"/>
                        <ComboBoxItem Content="30s"/>
                    </ComboBox>
                    <Button x:Name="OpenLogBtn" Content="📄" Style="{StaticResource IconButton}"
                            Click="OpenLog_Click" ToolTip="打开日志文件夹"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ROW 1: Login Bar ===== -->
        <Border Grid.Row="1" x:Name="LoginBar" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="账号" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="AccountTextBox" Style="{StaticResource ModernTextBox}"
                         VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="密码" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="16,0,8,0"/>
                <PasswordBox Grid.Column="3" x:Name="PasswordBox" VerticalAlignment="Center"
                             Background="#F8F9FB" BorderBrush="#EEEEEE" BorderThickness="1" Padding="8,6" FontSize="13"/>

                <TextBlock Grid.Column="4" Text="区域" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="16,0,8,0"/>
                <ComboBox Grid.Column="5" x:Name="RegionComboBox" Style="{StaticResource ModernComboBox}"
                          VerticalAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="cn"/>
                    <ComboBoxItem Content="eu"/>
                    <ComboBoxItem Content="us"/>
                    <ComboBoxItem Content="as"/>
                </ComboBox>

                <Button Grid.Column="6" x:Name="LoginButton" Content="登录获取设备"
                        Style="{StaticResource PrimaryButton}" Click="Login_Click" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- ===== ROW 2: Main Content ===== -->
        <Grid Grid.Row="2" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Device List -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <DockPanel DockPanel.Dock="Top" Margin="8,0,8,8">
                    <TextBlock Text="设备列表" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="DeviceCountText" Text="" DockPanel.Dock="Left"
                               Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="DeviceCardsPanel"/>
                </ScrollViewer>
            </DockPanel>

            <!-- RIGHT: Rules -->
            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="8,0,8,8">
                    <TextBlock Text="联动规则" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                    <Button Content="+ 新建规则" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                            Click="AddRule_Click" Padding="12,6"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RulesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DeviceCardStyle}" Margin="6">
                                    <StackPanel>
                                        <!-- 规则标题栏 -->
                                        <DockPanel Margin="0,0,0,12">
                                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                      DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                            <Button Content="✕" Style="{StaticResource DangerIconButton}" DockPanel.Dock="Right"
                                                    Click="DeleteRule_Click" ToolTip="删除规则"/>
                                        </DockPanel>

                                        <!-- ========== 条件区域 ========== -->
                                        <Border Background="#F8F9FB" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="📋 当满足以下条件时" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>

                                                <ItemsControl ItemsSource="{Binding Conditions}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" CornerRadius="6" Padding="8" Margin="0,4">
                                                                <Grid MinHeight="32">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="50"/>
                                                                        <ColumnDefinition Width="85"/>
                                                                        <ColumnDefinition Width="45"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="28"/>
                                                                        <ColumnDefinition Width="28"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- 逻辑运算符 -->
                                                                    <ComboBox Grid.Column="0" SelectedValue="{Binding Operator}" SelectedValuePath="Tag"
                                                                              Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center">
                                                                        <ComboBoxItem Content="且" Tag="And"/>
                                                                        <ComboBoxItem Content="或" Tag="Or"/>
                                                                    </ComboBox>

                                                                    <!-- 触发类型 -->
                                                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Type}" SelectedValuePath="Tag"
                                                                              Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center">
                                                                        <ComboBoxItem Content="时间" Tag="time"/>
                                                                        <ComboBoxItem Content="间隔" Tag="interval"/>
                                                                        <ComboBoxItem Content="CPU温度" Tag="cpu_temp"/>
                                                                        <ComboBoxItem Content="CPU使用率" Tag="cpu_usage"/>
                                                                        <ComboBoxItem Content="GPU温度" Tag="gpu_temp"/>
                                                                        <ComboBoxItem Content="应用启动" Tag="app_start"/>
                                                                        <ComboBoxItem Content="应用关闭" Tag="app_close"/>
                                                                        <ComboBoxItem Content="开机" Tag="boot"/>
                                                                        <ComboBoxItem Content="关机" Tag="shutdown"/>
                                                                        <ComboBoxItem Content="睡眠" Tag="sleep"/>
                                                                        <ComboBoxItem Content="唤醒" Tag="wake"/>
                                                                    </ComboBox>

                                                                    <!-- 比较运算符 -->
                                                                    <ComboBox Grid.Column="2" SelectedValue="{Binding Comparison}"
                                                                              Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"
                                                                              Visibility="{Binding ShowComparison, Converter={StaticResource BoolToVis}}">
                                                                        <ComboBox.ItemsSource>
                                                                            <x:Array Type="{x:Type core:ComparisonOperator}">
                                                                                <core:ComparisonOperator>Gte</core:ComparisonOperator>
                                                                                <core:ComparisonOperator>Gt</core:ComparisonOperator>
                                                                                <core:ComparisonOperator>Lte</core:ComparisonOperator>
                                                                                <core:ComparisonOperator>Lt</core:ComparisonOperator>
                                                                                <core:ComparisonOperator>Eq</core:ComparisonOperator>
                                                                                <core:ComparisonOperator>Neq</core:ComparisonOperator>
                                                                                <core:ComparisonOperator>Range</core:ComparisonOperator>
                                                                            </x:Array>
                                                                        </ComboBox.ItemsSource>
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={StaticResource ComparisonToDisplayConverter}}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>

                                                                    <!-- 条件值 -->
                                                                    <Grid Grid.Column="3" Margin="0,0,4,0">
                                                                        <!-- 时间选择 -->
                                                                        <StackPanel Visibility="{Binding IsTime, Converter={StaticResource BoolToVis}}">
                                                                            <local:TimePicker x:Name="ConditionTimePicker"
                                                                                              SelectedTime="{Binding Parameter, Mode=TwoWay}"
                                                                                              SelectedTimeChanged="ConditionTimePicker_SelectedTimeChanged"/>
                                                                        </StackPanel>
                                                                        <!-- 数字输入（单值） -->
                                                                        <StackPanel Visibility="{Binding IsNumeric, Converter={StaticResource BoolToVis}}"
                                                                            Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBox x:Name="NumericValueTextBox" FontSize="11" TextAlignment="Center"
                                                                                     VerticalContentAlignment="Center" Width="60"
                                                                                     Style="{StaticResource ModernTextBox}"
                                                                                     Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                                     Visibility="{Binding IsRangeComparison, Converter={StaticResource InverseBoolToVis}}"/>
                                                                            <!-- 范围输入（双值） -->
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                                        Visibility="{Binding IsRangeComparison, Converter={StaticResource BoolToVis}}">
                                                                                <TextBox FontSize="11" TextAlignment="Center" VerticalContentAlignment="Center" Width="45"
                                                                                         Style="{StaticResource ModernTextBox}"
                                                                                         Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                                <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="2,0"/>
                                                                                <TextBox FontSize="11" TextAlignment="Center" VerticalContentAlignment="Center" Width="45"
                                                                                         Style="{StaticResource ModernTextBox}"
                                                                                         Text="{Binding Parameter2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding ParameterUnit}" FontSize="11" Foreground="Gray"
                                                                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                        </StackPanel>
                                                                        <!-- 应用选择 -->
                                                                        <DockPanel Visibility="{Binding IsAppEvent, Converter={StaticResource BoolToVis}}">
                                            <StackPanel DockPanel.Dock="Left">
                                                <DockPanel>
                                                    <Button Content="浏览" DockPanel.Dock="Right" Width="40" Height="26" FontSize="10"
                                                            Click="AppBrowse_Click" Tag="{Binding}"/>
                                                    <TextBox Text="{Binding Parameter}" FontSize="11" IsReadOnly="True" Background="#F0F0F0"
                                                             VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                                </DockPanel>
                                            </StackPanel>
                                                                        </DockPanel>
                                                                        <!-- 无需参数 -->
                                                                        <TextBlock Text="(无需参数)" Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsNoParameter, Converter={StaticResource BoolToVis}}"/>
                                                                    </Grid>

                                                                    <!-- 占位（无比较运算符时） -->
                                                                    <Grid Grid.Column="4" Visibility="{Binding ShowComparison, Converter={StaticResource InverseBoolToVis}}"/>

                                                                    <!-- 测试 -->
                                                                    <Button Grid.Column="5" Content="▶" Style="{StaticResource IconButton}"
                                                                            Click="TestCondition_Click" Tag="{Binding}" ToolTip="测试条件"/>
                                                                    <!-- 删除 -->
                                                                    <Button Grid.Column="6" Content="✕" Style="{StaticResource IconButton}"
                                                                            Click="RemoveCondition_Click" Tag="{Binding}" ToolTip="删除"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="+ 添加条件" Style="{StaticResource GhostButton}" FontSize="11"
                                                        Margin="0,8,0,0" Click="AddCondition_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ========== 动作区域 ========== -->
                                        <Border Background="#F0F7FF" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="⚡ 执行以下动作" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>

                                                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" CornerRadius="6" Padding="8" Margin="0,4">
                                                                <Grid MinHeight="32">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="55"/>
                                                                        <ColumnDefinition Width="50"/>
                                                                        <ColumnDefinition Width="28"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- 设备选择 -->
                                                                    <ComboBox Grid.Column="0" Margin="0,0,4,0" FontSize="11"
                                                                              ItemsSource="{Binding DataContext.Devices, ElementName=MainWindowRoot}"
                                                                              DisplayMemberPath="Name"
                                                                              SelectedValuePath="DeviceId"
                                                                              SelectedValue="{Binding DeviceId, Mode=TwoWay}"/>

                                                                    <!-- 通道选择 -->
                                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Outlet}"
                                                                              Margin="0,0,4,0" FontSize="11">
                                                                        <ComboBoxItem Content="CH0"/>
                                                                        <ComboBoxItem Content="CH1"/>
                                                                        <ComboBoxItem Content="CH2"/>
                                                                        <ComboBoxItem Content="CH3"/>
                                                                    </ComboBox>

                                                                    <!-- 操作选择 -->
                                                                    <ComboBox Grid.Column="2" SelectedValue="{Binding State}" SelectedValuePath="Tag"
                                                                              Margin="0,0,4,0" FontSize="11">
                                                                        <ComboBoxItem Content="开" Tag="on"/>
                                                                        <ComboBoxItem Content="关" Tag="off"/>
                                                                    </ComboBox>

                                                                    <!-- 删除 -->
                                                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}"
                                                                            Click="RemoveAction_Click" Tag="{Binding}" ToolTip="删除"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="+ 添加动作" Style="{StaticResource GhostButton}" FontSize="11"
                                                        Margin="0,8,0,0" Click="AddAction_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ===== ROW 3: Bottom Toolbar ===== -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshIPBtn" Content="刷新IP" Style="{StaticResource GhostButton}"
                            Click="RefreshIP_Click" Margin="0,0,6,0"/>
                    <Button x:Name="RefreshStateBtn" Content="刷新状态" Style="{StaticResource GhostButton}"
                            Click="RefreshState_Click"/>
                </StackPanel>

                <Button Grid.Column="2" Content="保存配置" Style="{StaticResource PrimaryButton}"
                        Click="SaveConfig_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
