<Window x:Class="EWeLinkLinker.ConfigApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EWeLinkLinker.ConfigApp"
        mc:Ignorable="d"
        x:Name="MainWindowRoot"
        Title="EWeLink Linker" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPageBrush}">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:BoolToStringConverter x:Key="BoolToText" TrueValue="是" FalseValue="否"/>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>
        <local:ComparisonToDisplayConverter x:Key="ComparisonToDisplayConverter"/>
        <local:ChannelListConverter x:Key="ChannelList"/>

        <!-- (模板选择器已移除，改用 Visibility 绑定) -->

        <!-- 取值全部来自 Resources/Styles.xaml（应用级唯一一份）。
             这里原来还有一份同名 key（Divider 一份 #E0E0E0 一份 #EEEEEE），本地那份会遮住应用级那份。 -->

    </Window.Resources>

    <!-- ==================== Main Layout ==================== -->
    <!-- 默认字色挂在这里（而不是隐式 TextBlock 样式里），按钮自己的前景才盖得过它 -->
    <Grid TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ===== ROW 0: Top Status Bar ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="6"
                            Width="28" Height="28" Margin="0,0,10,0">
                        <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="EWeLink Linker" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Service Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse x:Name="ServiceStatusDot" Width="9" Height="9"
                             Fill="{StaticResource StatusOfflineBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ServiceStatusText" Text="服务: 检测中..." Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 顶栏只留"常驻可见"的东西：服务状态 + 日志开关 + 轮询间隔 + 打开日志。
                     安装/启动/卸载挪到登录那一行的右侧空位（见 ROW 1）。 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="LoggingCheckBox" Content="日志" IsChecked="True"
                              VerticalAlignment="Center" Margin="16,0,10,0"
                              Checked="LoggingCheckBox_Checked" Unchecked="LoggingCheckBox_Unchecked"/>
                    <TextBlock Text="轮询:" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource CaptionText}"/>
                    <ComboBox x:Name="PollingIntervalCombo" Width="60" VerticalAlignment="Center"
                              SelectedIndex="3" Margin="0,0,6,0" SelectionChanged="PollingIntervalCombo_SelectionChanged">
                        <ComboBoxItem Content="1s"/>
                        <ComboBoxItem Content="2s"/>
                        <ComboBoxItem Content="3s"/>
                        <ComboBoxItem Content="5s"/>
                        <ComboBoxItem Content="10s"/>
                        <ComboBoxItem Content="15s"/>
                        <ComboBoxItem Content="30s"/>
                    </ComboBox>
                    <Button x:Name="OpenLogBtn" Style="{StaticResource IconButton}"
                            Click="OpenLog_Click" ToolTip="打开日志文件夹"><Path Width="15" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" Fill="Transparent" Data="M1,2 L6,2 L8,4 L14,4 L14,12 L1,12 Z"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ROW 1: Login Bar ===== -->
        <Border Grid.Row="1" x:Name="LoginBar" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="账号" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="AccountTextBox" Style="{StaticResource ModernTextBox}"
                         VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="密码" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="16,0,8,0"/>
                <PasswordBox Grid.Column="3" x:Name="PasswordBox" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="区域" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="16,0,8,0"/>
                <ComboBox Grid.Column="5" x:Name="RegionComboBox" Style="{StaticResource ModernComboBox}"
                          VerticalAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="cn"/>
                    <ComboBoxItem Content="eu"/>
                    <ComboBoxItem Content="us"/>
                    <ComboBoxItem Content="as"/>
                </ComboBox>

                <Button Grid.Column="6" x:Name="LoginButton" Content="登录获取设备"
                        Style="{StaticResource PrimaryButton}" Click="Login_Click" Margin="16,0,0,0"/>

                <!-- 服务动作挪到登录行右半边（那里原来是一片空的）。
                     离了顶栏的"服务:"字样，光写"安装/卸载"看不出装的是什么，所以补上"服务"二字。 -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="InstallServiceBtn" Content="安装服务" Style="{StaticResource GhostButton}"
                            Click="InstallService_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ToggleServiceBtn" Content="启动" Style="{StaticResource GhostButton}"
                            Click="ToggleService_Click" Margin="0,0,6,0"/>
                    <Button x:Name="RemoveServiceBtn" Content="卸载服务" Style="{StaticResource GhostButton}"
                            Click="RemoveService_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ROW 2: Main Content ===== -->
        <Grid Grid.Row="2" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Device List -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <DockPanel DockPanel.Dock="Top" Margin="8,0,8,8">
                    <TextBlock Text="设备列表" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="DeviceCountText" Text="" DockPanel.Dock="Left" Style="{StaticResource CaptionText}" Margin="8,0,0,0"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="DeviceCardsPanel"/>
                </ScrollViewer>
            </DockPanel>

            <!-- RIGHT: Rules -->
            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="8,0,8,8" LastChildFill="False">
                    <TextBlock Text="联动规则" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                    <Button Content="+ 新建规则" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                            Click="AddRule_Click" Padding="12,6"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RulesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DeviceCardStyle}" Margin="6">
                                    <StackPanel>
                                        <!-- 规则标题栏 -->
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DangerIconButton}"
                                                    Click="DeleteRule_Click" ToolTip="删除规则"><Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" Data="M0,0 L10,10 M10,0 L0,10"/></Button>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" FontSize="15"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- ========== 条件区域 ========== -->
                                        <Border Background="{StaticResource SubtleBrush}" CornerRadius="{StaticResource CardCorner}" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Path Width="12" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" Fill="Transparent"
                                                          Data="M1,1 L9,1 L11,3 L11,14 L1,14 Z M3.5,5.5 L7.5,5.5 M3.5,8 L7.5,8 M3.5,10.5 L6,10.5"/>
                                                    <TextBlock Text="当满足以下条件时" Style="{StaticResource SectionTitleText}"/>
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding Conditions}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- 整行按内容收宽：以前第 4 列是 *，"开机"这类无参数条件右边会空出一大片 -->
                                                            <Border Background="{StaticResource CardBrush}" CornerRadius="{StaticResource ControlCorner}" Padding="8" Margin="0,4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                                <Grid MinHeight="32">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- 逻辑运算符 -->
                                                                    <ComboBox Grid.Column="0" SelectedValue="{Binding Operator}" SelectedValuePath="Tag"
                                                                              MinWidth="46" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <ComboBoxItem Content="且" Tag="And"/>
                                                                        <ComboBoxItem Content="或" Tag="Or"/>
                                                                    </ComboBox>

                                                                    <!-- 触发类型 -->
                                                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Type}" SelectedValuePath="Tag"
                                                                              SelectionChanged="ConditionTypeCombo_SelectionChanged"
                                                                              MinWidth="98" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <ComboBoxItem Content="时间" Tag="time"/>
                                                                        <ComboBoxItem Content="间隔" Tag="interval"/>
                                                                        <ComboBoxItem Content="CPU温度" Tag="cpu_temp"/>
                                                                        <ComboBoxItem Content="CPU使用率" Tag="cpu_usage"/>
                                                                        <ComboBoxItem Content="GPU温度" Tag="gpu_temp"/>
                                                                        <ComboBoxItem Content="应用启动" Tag="app_start"/>
                                                                        <ComboBoxItem Content="应用关闭" Tag="app_close"/>
                                                                        <ComboBoxItem Content="开机" Tag="boot"/>
                                                                        <ComboBoxItem Content="关机" Tag="shutdown"/>
                                                                        <ComboBoxItem Content="睡眠" Tag="sleep"/>
                                                                        <ComboBoxItem Content="唤醒" Tag="wake"/>
                                                                    </ComboBox>

                                                                    <!-- 比较运算符 -->
                                                                    <ComboBox Grid.Column="2" SelectedValue="{Binding Comparison}"
                                                                              ItemsSource="{Binding AvailableComparisons}"
                                                                              SelectionChanged="ComparisonComboBox_SelectionChanged"
                                                                              MinWidth="46" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                              Visibility="{Binding ShowComparison, Converter={StaticResource BoolToVis}}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={StaticResource ComparisonToDisplayConverter}}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>

                                                                    <!-- 条件值 -->
                                                                    <Grid Grid.Column="3" Margin="0,0,4,0">
                                                                        <!-- 时间选择 -->
                                                                        <StackPanel Visibility="{Binding IsTime, Converter={StaticResource BoolToVis}}">
                                                                            <local:TimePicker x:Name="ConditionTimePicker"
                                                                                              SelectedTime="{Binding Parameter, Mode=TwoWay}"
                                                                                              SelectedTimeChanged="ConditionTimePicker_SelectedTimeChanged"/>
                                                                        </StackPanel>
                                                                        <!-- 数字输入（单值） -->
                                                                        <StackPanel Visibility="{Binding IsNumeric, Converter={StaticResource BoolToVis}}"
                                                                            Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBox x:Name="NumericValueTextBox" TextAlignment="Center"
                                                                                     VerticalContentAlignment="Center" Width="60"
                                                                                     Style="{StaticResource ModernTextBox}"
                                                                                     Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                                     Visibility="{Binding IsRangeComparison, Converter={StaticResource InverseBoolToVis}}"/>
                                                                            <!-- 单位跟着数值走。原来它挂在整个 StackPanel 末尾，
                                                                                 行一收窄就变成"80 抖动± 无 °C"，读起来像单位属于抖动框 -->
                                                                            <TextBlock Text="{Binding ParameterUnit}" Style="{StaticResource CaptionText}"
                                                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                       Visibility="{Binding IsRangeComparison, Converter={StaticResource InverseBoolToVis}}"/>
                                                                            <!-- 滞回带宽：配置里存意图值，解除线由比较符方向派生；清空=不启用 -->
                                                                            <TextBlock Text="抖动±" Style="{StaticResource CaptionText}"
                                                                                       VerticalAlignment="Center" Margin="6,0,2,0"
                                                                                       Visibility="{Binding ShowRelease, Converter={StaticResource BoolToVis}}"/>
                                                                            <Grid VerticalAlignment="Center" Visibility="{Binding ShowRelease, Converter={StaticResource BoolToVis}}">
                                                                                <ComboBox x:Name="HysteresisCombo" IsEditable="True" DisplayMemberPath="Content"
                                                                                          Width="54" VerticalContentAlignment="Center"
                                                                                          ToolTip="滞回带宽：允许阈值附近抖动多少而不重新武装。方向由比较符自动判定（≥ 往低、≤ 往高）。清空表示不启用。"
                                                                                          Text="{Binding ReleaseBand, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                                                                    <ComboBoxItem Content="2"/>
                                                                                    <ComboBoxItem Content="3"/>
                                                                                    <ComboBoxItem Content="5"/>
                                                                                    <ComboBoxItem Content="8"/>
                                                                                    <ComboBoxItem Content="10"/>
                                                                                </ComboBox>
                                                                                <!-- 空着的时候看起来像漏填，这里补一个占位词；不拦截鼠标，点上去仍然进下拉框 -->
                                                                                <TextBlock Text="无" IsHitTestVisible="False" FontSize="12" Margin="7,0,0,0"
                                                                                           VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Text, ElementName=HysteresisCombo}" Value="">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding ReleaseHint}" Style="{StaticResource CaptionText}"
                                                                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                       Visibility="{Binding ShowRelease, Converter={StaticResource BoolToVis}}"/>
                                                                            <!-- 范围输入（双值） -->
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                                        Visibility="{Binding IsRangeComparison, Converter={StaticResource BoolToVis}}">
                                                                                <TextBox TextAlignment="Center" VerticalContentAlignment="Center" Width="48"
                                                                                         Style="{StaticResource ModernTextBox}"
                                                                                         Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                                <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="2,0"/>
                                                                                <TextBox TextAlignment="Center" VerticalContentAlignment="Center" Width="48"
                                                                                         Style="{StaticResource ModernTextBox}"
                                                                                         Text="{Binding Parameter2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                                <TextBlock Text="{Binding ParameterUnit}" Style="{StaticResource CaptionText}"
                                                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                        <!-- 应用选择：整行按内容收宽之后必须给死宽度，
                                                                             否则"填充剩余空间"的输入框会塌成 0 宽 -->
                                                                        <DockPanel LastChildFill="False" VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsAppEvent, Converter={StaticResource BoolToVis}}">
                                                                            <TextBox Width="220" DockPanel.Dock="Left" Margin="0,0,4,0"
                                                                                     ToolTip="可直接输入进程名（不含 .exe，不带路径），或点「浏览」选择"
                                                                                     Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                            <Button Content="浏览" Width="40" Height="26" DockPanel.Dock="Left"
                                                                                    Click="AppBrowse_Click" Tag="{Binding}"/>
                                                                        </DockPanel>
                                                                        <!-- 无需参数 -->
                                                                        <TextBlock Text="(无需参数)" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsNoParameter, Converter={StaticResource BoolToVis}}"/>
                                                                    </Grid>

                                                                    <!-- 测试 -->
                                                                    <Button Grid.Column="4" Style="{StaticResource IconButton}"
                                                                            Click="TestCondition_Click" Tag="{Binding}" ToolTip="测试条件"><Path Width="10" Height="11" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M0,0 L11,5.5 L0,11 Z"/></Button>
                                                                    <!-- 删除 -->
                                                                    <Button Grid.Column="5" Style="{StaticResource IconButton}"
                                                                            Click="RemoveCondition_Click" Tag="{Binding}" ToolTip="删除"><Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" Data="M0,0 L10,10 M10,0 L0,10"/></Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="+ 添加条件" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                        Margin="0,8,0,0" Click="AddCondition_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ========== 动作区域 ========== -->
                                        <Border Background="{StaticResource AccentLightBrush}" CornerRadius="{StaticResource CardCorner}" Padding="12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Path Width="11" Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                          Fill="{StaticResource AccentBrush}"
                                                          Data="M6.5,0 L0,8 L4,8 L3,14 L9.5,6 L5.5,6 Z"/>
                                                    <TextBlock Text="执行以下动作" Style="{StaticResource SectionTitleText}"/>
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource CardBrush}" CornerRadius="{StaticResource ControlCorner}" Padding="8" Margin="0,4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                                <Grid MinHeight="32">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- 设备选择 -->
                                                                    <ComboBox Grid.Column="0" Margin="0,0,6,0" MinWidth="180" MaxWidth="300"
                                                                              ItemsSource="{Binding DataContext.Devices, ElementName=MainWindowRoot}"
                                                                              DisplayMemberPath="Name"
                                                                              SelectedValuePath="DeviceId"
                                                                              SelectionChanged="ActionDeviceCombo_SelectionChanged"
                                                                              SelectedValue="{Binding DeviceId, Mode=TwoWay}"/>

                                                                    <!-- 通道选择：候选按这台设备的通道数生成（老界面写死 CH0–CH3，8 路插排选不到 4–7） -->
                                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding OutletIndex, Mode=TwoWay}"
                                                                              SelectionChanged="ChannelCombo_SelectionChanged"
                                                                              MinWidth="56" Margin="0,0,4,0">
                                                                        <ComboBox.ItemsSource>
                                                                            <MultiBinding Converter="{StaticResource ChannelList}">
                                                                                <Binding Path="DeviceId"/>
                                                                                <Binding Path="Outlet"/>
                                                                                <Binding Path="DataContext.Devices" ElementName="MainWindowRoot"/>
                                                                            </MultiBinding>
                                                                        </ComboBox.ItemsSource>
                                                                    </ComboBox>

                                                                    <!-- 操作选择 -->
                                                                    <ComboBox Grid.Column="2" SelectedValue="{Binding State}" SelectedValuePath="Tag"
                                                                              MinWidth="52" Margin="0,0,4,0">
                                                                        <ComboBoxItem Content="开" Tag="on"/>
                                                                        <ComboBoxItem Content="关" Tag="off"/>
                                                                    </ComboBox>

                                                                    <!-- 删除 -->
                                                                    <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                                            Click="RemoveAction_Click" Tag="{Binding}" ToolTip="删除"><Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" Data="M0,0 L10,10 M10,0 L0,10"/></Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="+ 添加动作" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                        Margin="0,8,0,0" Click="AddAction_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ===== ROW 3: Bottom Toolbar ===== -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshIPBtn" Content="刷新IP" Style="{StaticResource GhostButton}"
                            Click="RefreshIP_Click" Margin="0,0,6,0"/>
                    <Button x:Name="RefreshStateBtn" Content="刷新状态" Style="{StaticResource GhostButton}"
                            Click="RefreshState_Click"/>
                </StackPanel>

                <Button Grid.Column="2" Content="保存配置" Style="{StaticResource PrimaryButton}"
                        Click="SaveConfig_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
